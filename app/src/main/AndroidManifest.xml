<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <queries>
        <package android:name="org.xbmc.kodi" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="StreamHub"
        android:icon="@drawable/ic_streamhub"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.StreamHub"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/streamhub_network_security">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <activity
            android:name=".EpgActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".UnifiedSearchActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".XtreamActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".MacPortalProfilesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".MacPortalActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".LiveTvActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".LiveTvPlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".SourceDirectoryActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".MediaLibraryActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".DeVideoPlayerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".PublicFeedActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".NativeHubActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
