<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only the Kodi JSON-RPC webserver on this same Android device. -->
    <!-- HTTP is enabled at OS level for user-supplied MAG portals; the portal UI
         requires an explicit opt-in before sending MAC credentials over HTTP. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain>localhost</domain>
        <domain>127.0.0.1</domain>
    </domain-config>
</network-security-config>
